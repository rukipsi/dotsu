#!/usr/bin/env bash
export WINEPREFIX="$HOME/.wine-csp"
export WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS="--no-sandbox"

RESOLUTION=$(hyprctl monitors | awk '/[0-9]x[0-9]/ {split($1, a, "@"); print a[1]; exit}')
wine explorer /desktop=CSP,${RESOLUTION} "C:\Program Files\CELSYS\CLIP STUDIO 1.5\CLIP STUDIO PAINT\CLIPStudioPaint.exe"
